// 《夜に駆ける》harmony-based Strudel arrangement
// 130 BPM / 4-4 / Eb major and C minor colour.
// This keeps the public harmonic outline and uses a new topline.

setcpm(130 / 4)

const piano = cat(
  note("ab3 eb4 g4 c5 ab4 eb4 g4 c5 ab3 eb4 g4 c5 ab4 eb4 g4 c5"),
  note("bb3 f4 ab4 d5 bb4 f4 ab4 d5 bb3 f4 ab4 d5 bb4 f4 ab4 d5"),
  note("b3 g4 b4 d5 f5 d5 b4 g4 b3 g4 b4 d5 f5 d5 b4 g4"),
  note("c4 g4 bb4 eb5 c5 g4 bb4 eb5 c4 g4 bb4 eb5 c5 g4 bb4 eb5"),
  note("ab3 eb4 g4 c5 ab4 eb4 g4 c5 ab3 eb4 g4 c5 ab4 eb4 g4 c5"),
  note("g3 d4 f4 b4 g4 d4 f4 b4 g3 d4 f4 b4 g4 d4 f4 b4"),
  note("c4 g4 bb4 eb5 c5 g4 bb4 eb5 c4 g4 bb4 eb5 c5 g4 bb4 eb5"),
  note("eb4 bb4 d5 g5 eb5 bb4 d5 g5 eb4 bb4 d5 g5 eb5 bb4 d5 g5"),
)
  .s("gm_piano")
  .clip(.34)
  .gain(".42 .31 .36 .29")
  .room(.18)
  .pan(".43 .57")

const bass = cat(
  note("ab2 ~ ab2 eb3 ab2 ~ g2 eb2"),
  note("bb2 ~ bb2 f3 bb2 ~ ab2 f2"),
  note("b2 ~ b2 f3 g2 ~ b2 d3"),
  note("c3 ~ c3 g2 c3 ~ bb2 g2"),
  note("ab2 ~ ab2 eb3 ab2 ~ g2 eb2"),
  note("g2 ~ g2 d3 g2 ~ f2 d2"),
  note("c3 g2 c3 eb3 c3 ~ bb2 g2"),
  note("eb2 bb2 eb3 g3 eb3 d3 bb2 g2"),
)
  .s("gm_electric_bass_finger")
  .clip(.55)
  .lpf(1500)
  .gain(.62)

// Newly written melodic contour: similar energy, not the song's vocal melody.
const topline = cat(
  note("eb5 g5 ab5 g5 f5 eb5 c5 bb4"),
  note("d5 f5 g5 f5 eb5 d5 bb4 ab4"),
  note("b4 d5 g5 f5 d5 b4 a4 g4"),
  note("c5 eb5 g5 bb5 g5 f5 eb5 d5"),
  note("eb5 g5 c6 bb5 g5 eb5 d5 c5"),
  note("b4 d5 f5 g5 f5 d5 b4 a4"),
  note("c5 d5 eb5 g5 bb5 g5 f5 eb5"),
  note("g5 f5 eb5 d5 bb4 g4 ~ eb5"),
)
  .s("triangle")
  .attack(.01)
  .release(.12)
  .lpf(3200)
  .gain(.28)
  .room(.24)

const kick = s("bd ~ ~ bd ~ ~ bd ~").bank("RolandTR909").gain(.82)
const snare = s("~ ~ sd ~ ~ ~ sd ~").bank("RolandTR909").gain(.55).room(.12)
const hats = s("hh*16")
  .bank("RolandTR909")
  .gain(".22 .11 .16 .1")
  .pan(".47 .53")

const strings = cat(
  note("[ab3,c4,eb4,g4]"),
  note("[bb3,d4,f4,ab4]"),
  note("[b3,d4,f4,g4]"),
  note("[c4,eb4,g4,bb4]"),
  note("[ab3,c4,eb4,g4]"),
  note("[g3,b3,d4,f4]"),
  note("[c4,eb4,g4,bb4]"),
  note("[eb4,g4,bb4,d5]"),
)
  .s("gm_synth_strings_1")
  .attack(.08)
  .release(.45)
  .gain(.16)

stack(piano, bass, topline, kick, snare, hats, strings)
